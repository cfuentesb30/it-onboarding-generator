FLASK_ENV=development
SECRET_KEY=change-me-in-production   # generate one: python3 -c "import secrets; print(secrets.token_hex(32))"
RESEND_API_KEY=re_your_key_here
# RESEND_FROM=you@yourdomain.com   # set after verifying a domain in Resend — otherwise falls back to the rate-limited onboarding@resend.dev sandbox sender
OWNER_EMAIL=you@example.com        # email address that receives owner notifications
APP_URL=http://localhost:5000      # used in email links/buttons — set to your real domain in production

# --- PostgreSQL (Docker Compose) ---
# Docker Compose builds DATABASE_URL for the app from these three values.
# Use letters and numbers only in the password (it goes inside a URL):
#   openssl rand -hex 24
POSTGRES_USER=onboarding
POSTGRES_PASSWORD=change-me
POSTGRES_DB=onboarding

# Port on 127.0.0.1 where the app is published (default 5000)
# APP_PORT=5000

# Production server only: skip the development override
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Only when running the app outside Docker (python run.py) against a reachable PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/onboarding
